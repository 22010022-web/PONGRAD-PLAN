# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive API (Service Account)
# วิธีที่ 1: ใส่ JSON ทั้งก้อนของ credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# วิธีที่ 2 (ทางเลือก): แยกใส่ Email และ Private Key
# GOOGLE_SERVICE_ACCOUNT_EMAIL=school-drive-bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-shared-google-drive-folder-id

# LINE Messaging API (Optional)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
